---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import Layout from "./Layout.astro"
import PageHeader from "../components/PageHeader.astro"
import { site } from "../data/site"

interface Props {
  title: string
  description?: string
  date: Date
  image?: ImageMetadata
  imageCaption?: string
}

const { title, description, date, image, imageCaption } = Astro.props

const dateFormatted = date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<Layout title={`${title} — ${site.author.name}`} description={description}>
  <article>
    <PageHeader
      title={title}
      subtitle={description}
      kicker={`writing · ${dateFormatted}`}
    />

    {
      image && (
        <figure class="cover">
          <Image
            src={image}
            alt={imageCaption ?? ""}
            class="cover-image"
          />
          {imageCaption && (
            <figcaption class="cover-caption">{imageCaption}</figcaption>
          )}
        </figure>
      )
    }

    <section class="prose">
      <slot />
    </section>

    <nav class="back-nav">
      <a href="/writings">← All writings</a>
    </nav>
  </article>
</Layout>

<style>
  .cover {
    margin-bottom: var(--spacing-fluid-2xl);
  }

  .cover-image {
    width: 100%;
    border-radius: 2px;
    object-fit: cover;
    object-position: center;
    background: var(--color-bg-subtle);
  }

  @media (min-width: 768px) {
    .cover-image {
      max-height: 500px;
    }
  }

  .cover-caption {
    margin-top: var(--spacing-fluid-s);
    text-align: center;
    color: var(--color-text-faint);
    font-size: var(--text-fluid-xs);
  }

  .back-nav {
    margin-top: var(--spacing-fluid-3xl);
    font-size: var(--text-fluid-xs);
  }

  .back-nav a {
    text-decoration: underline;
    text-decoration-color: var(--color-gray-7);
    text-underline-offset: max(0.15em, 3px);
  }
</style>
