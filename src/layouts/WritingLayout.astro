---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import Layout from "./Layout.astro"
import PageHeader from "../components/PageHeader.astro"

interface Props {
  title: string
  description?: string
  date: Date
  image?: ImageMetadata
  imageCaption?: string
}

const { title, description, date, image, imageCaption } = Astro.props

const dateFormatted = date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<Layout title={`${title} — Matteo Cavallo`} description={description}>
  <article>
    <PageHeader
      title={title}
      subtitle={description}
      kicker={`writing · ${dateFormatted}`}
    />

    {
      image && (
        <figure class="writing-cover">
          <Image
            src={image}
            alt={imageCaption ?? ""}
            class="writing-cover-image"
          />
          {imageCaption && (
            <figcaption class="writing-cover-caption">
              {imageCaption}
            </figcaption>
          )}
        </figure>
      )
    }

    <section class="prose">
      <slot />
    </section>

    <nav class="writing-back">
      <a href="/writings">← All writings</a>
    </nav>
  </article>
</Layout>

<style>
  .writing-cover {
    margin-bottom: var(--spacing-fluid-2xl);
  }

  .writing-cover-image {
    width: 100%;
    border-radius: 2px;
    object-fit: cover;
    object-position: center;
    background: var(--color-bg-subtle);
  }

  @media (min-width: 768px) {
    .writing-cover-image {
      max-height: 500px;
    }
  }

  .writing-cover-caption {
    margin-top: var(--spacing-fluid-s);
    text-align: center;
    color: var(--color-text-faint);
    font-size: var(--text-fluid-xs);
  }

  .writing-back {
    margin-top: var(--spacing-fluid-3xl);
    font-size: var(--text-fluid-xs);
  }
</style>
