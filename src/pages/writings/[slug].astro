---
import { getCollection, render } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import Layout from "../../layouts/Layout.astro"

export async function getStaticPaths() {
  const writings = await getCollection("writings", ({ data }) => !data.draft)
  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"writings">
}

const { entry } = Astro.props
const { Content } = await render(entry)

const dateFormatted = entry.data.date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<Layout
  title={`${entry.data.title} — Matteo Cavallo`}
  description={entry.data.description}
>
  <article>
    <header class="mb-(--spacing-fluid-2xl)">
      <p class="text-text-muted text-sm tabular-nums lowercase">
        writing &nbsp;·&nbsp;
        <time datetime={entry.data.date.toISOString()}>{dateFormatted}</time>
      </p>
      <h1
        class="mt-(--spacing-fluid-m) text-(length:--text-fluid-3xl) leading-(--line-height-display) tracking-(--tracking-display) font-semibold text-balance"
      >
        {entry.data.title}
      </h1>
      <p
        class="text-text-muted mt-(--spacing-fluid-m) text-(length:--text-fluid-base) leading-(--line-height-snug) max-w-[55ch]"
      >
        <em>{entry.data.description}</em>
      </p>
    </header>

    {
      entry.data.image && (
        <figure class="mb-(--spacing-fluid-2xl)">
          <Image
            src={entry.data.image}
            alt={entry.data.imageCaption ?? ""}
            class="w-full rounded-sm object-cover object-center md:max-h-[500px]"
          />
          {entry.data.imageCaption && (
            <figcaption class="text-text-faint mt-(--spacing-fluid-s) text-center text-sm">
              {entry.data.imageCaption}
            </figcaption>
          )}
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <nav class="mt-(--spacing-fluid-3xl)">
      <a href="/writings" class="text-sm">← All writings</a>
    </nav>
  </article>
</Layout>
