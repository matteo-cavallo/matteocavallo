---
import { getCollection, render } from "astro:content"
import type { CollectionEntry } from "astro:content"
import WritingLayout from "../../layouts/WritingLayout.astro"

export async function getStaticPaths() {
  const writings = await getCollection("writings", ({ data }) => !data.draft)
  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"writings">
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<WritingLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  image={entry.data.image}
  imageCaption={entry.data.imageCaption}
>
  <Content />
</WritingLayout>
