---
import { getCollection, render } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import Layout from "../../layouts/Layout.astro"
import { site } from "../../data/site"

export async function getStaticPaths() {
  const writings = await getCollection("writings", ({ data }) => !data.draft)
  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"writings">
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { title, description, date, image, imageCaption } = entry.data

const dateFormatted = date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<Layout title={`${title} — ${site.author.name}`} description={description}>
  <header class="page-header">
    <p class="page-kicker">{dateFormatted}</p>
    <h1 class="page-title">{title}</h1>
    {
      description && (
        <p class="page-subtitle">
          {description}
        </p>
      )
    }
  </header>

  {
    image && (
      <figure class="cover">
        <Image src={image} alt={imageCaption ?? ""} class="cover-image" />
        {imageCaption && (
          <figcaption class="cover-caption">{imageCaption}</figcaption>
        )}
      </figure>
    )
  }

  <article>
    <Content />
  </article>

  <nav class="back-nav">
    <a href="/writings">← All writings</a>
  </nav>
</Layout>

<style>
  .cover {
    margin-bottom: var(--spacing-fluid-2xl);
  }

  .cover-image {
    width: 100%;
    aspect-ratio: 2 / 1;
    max-height: 500px;
    border-radius: 2px;
    object-fit: cover;
    object-position: center;
    background: var(--color-bg-subtle);
  }

  .cover-caption {
    margin-top: var(--spacing-fluid-s);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-fluid-xs);
  }

  .back-nav {
    margin-top: var(--spacing-fluid-3xl);
    font-size: var(--text-fluid-xs);
  }

  .back-nav a {
    text-decoration: underline;
    text-decoration-color: var(--color-gray-7);
    text-underline-offset: max(0.15em, 3px);
  }
</style>

<style is:global>
  article .heading-anchor {
    color: var(--color-text-faint);
    display: inline-block;
    margin-inline-start: 0.25em;
    text-decoration: none;
    opacity: 0;
    transition:
      opacity 200ms ease,
      color 200ms ease;
  }

  article :is(h2, h3, h4, h5, h6):hover .heading-anchor,
  article .heading-anchor:focus-visible {
    opacity: 1;
  }

  @media (hover: hover) {
    article .heading-anchor:hover {
      color: var(--color-text);
    }
  }

  @media (hover: none) {
    article .heading-anchor {
      opacity: 1;
    }
  }
</style>
