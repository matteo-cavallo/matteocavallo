---
import { getCollection, render } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import Layout from "../../layouts/Layout.astro"
import PageHeader from "../../components/PageHeader.astro"
import { formatDate } from "../../utils/date"
import { site } from "../../data/site"

export async function getStaticPaths() {
  const writings = await getCollection("writings", ({ data }) => !data.draft)
  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"writings">
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { title, description, date, image, imageCaption } = entry.data

const dateFormatted = formatDate(date)
---

<Layout title={`${title} — ${site.author.name}`} description={description}>
  <PageHeader title={title} kicker={dateFormatted}>
    {description && <p class="page-subtitle">{description}</p>}
  </PageHeader>

  {
    image && (
      <figure class="cover">
        <Image src={image} alt={imageCaption ?? ""} class="cover-image" />
        {imageCaption && (
          <figcaption class="cover-caption">{imageCaption}</figcaption>
        )}
      </figure>
    )
  }

  <article>
    <Content />
  </article>

  <nav class="back-nav">
    <a href="/writings" class="muted-link">← All writings</a>
  </nav>
</Layout>

<style>
  .cover {
    margin-bottom: var(--spacing-fluid-2xl);
  }

  .cover-image {
    width: 100%;
    aspect-ratio: 2 / 1;
    max-height: 500px;
    border-radius: 2px;
    object-fit: cover;
    object-position: center;
    background: var(--color-bg-subtle);
  }

  .cover-caption {
    margin-top: var(--spacing-fluid-s);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-fluid-xs);
  }

  .back-nav {
    margin-top: var(--spacing-fluid-3xl);
    font-size: var(--text-fluid-xs);
  }
</style>
