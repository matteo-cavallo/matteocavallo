---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import WritingItem from "../../components/WritingItem.astro"

const writings = await getCollection("writings", ({ data }) => !data.draft)
writings.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Layout
  title="Writings — Matteo Cavallo"
  description="Notes on craft, slowness, and the way things are made."
>
  <header class="mb-(--spacing-fluid-3xl)">
    <h1
      class="text-(length:--text-fluid-3xl) leading-(--line-height-display) tracking-(--tracking-display) font-semibold"
    >
      Writings
    </h1>
    <p class="text-text-muted mt-(--spacing-fluid-s) max-w-[55ch]">
      <em>Notes from the making.</em>
    </p>
  </header>
  <section class="flex flex-col">
    {
      writings.map((piece) => (
        <WritingItem
          title={piece.data.title}
          href={`/writings/${piece.id}`}
          date={piece.data.date}
          description={piece.data.description}
        />
      ))
    }
  </section>
</Layout>
