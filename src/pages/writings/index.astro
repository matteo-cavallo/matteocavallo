---
import Layout from "../../layouts/Layout.astro"
import WritingItem from "../../components/WritingItem.astro"
import { site } from "../../data/site"
import { getPublishedWritings } from "../../utils/writings"

const writings = await getPublishedWritings()
---

<Layout
  title={`Writings — ${site.author.name}`}
  description="Notes on craft, slowness, and the way things are made."
>
  <header class="page-header">
    <h1 class="page-title">Writings</h1>
    <p class="page-subtitle"><em>Notes from the making.</em></p>
  </header>
  <section class="writings-list">
    {
      writings.map((piece) => (
        <WritingItem
          title={piece.data.title}
          href={`/writings/${piece.id}`}
          date={piece.data.date}
          description={piece.data.description}
        />
      ))
    }
  </section>
</Layout>

<style>
  .writings-list {
    display: flex;
    flex-direction: column;
  }
</style>
