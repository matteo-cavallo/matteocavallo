---
import Layout from "../layouts/Layout.astro"
import { site } from "../data/site"
---

<Layout title={`404 — ${site.author.name}`} description="Page not found.">
  <section class="not-found">
    <p class="page-kicker">404</p>
    <h1 class="page-title">Page not found.</h1>
    <p class="back-link"><a href="/" class="muted-link">← Back home</a></p>
  </section>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-fluid-m);
  }

  /* flex gap handles spacing; suppress the page-kicker margin-bottom that would double it */
  .not-found .page-kicker {
    margin-bottom: 0;
  }

  .back-link {
    font-size: var(--text-fluid-xs);
  }
</style>
