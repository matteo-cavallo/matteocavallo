---
import type { Work } from "../data/site"

type Props = Work

const { title, href, type, year, description, image, imageAlt } = Astro.props
---

<div class="work-item list-item">
  <details>
    <summary class="work-summary">
      <div class="work-header">
        <span class="work-title">{title}</span>
        <p class="work-meta">
          <span class="work-year">{year}</span>
          <span class="work-sep" aria-hidden="true">·</span>
          <span class="work-type">{type}</span>
        </p>
      </div>
      <svg
        class="disclosure-icon"
        width="10"
        height="10"
        viewBox="0 0 10 10"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 1.5L7 5L3 8.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </summary>
  </details>
  <div class="work-body-outer">
    <div class="work-body">
      <div class="work-body-inner">
        <div class="work-text">
          <p class="work-description">{description}</p>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="work-link"
          >
            Visit
            <svg
              width="10"
              height="10"
              viewBox="0 0 10 10"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 8L8 2M8 2H3.5M8 2V6.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        {
          image && (
            <img src={image} alt={imageAlt ?? title} class="work-image" />
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  details {
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }
  }

  .work-summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-fluid-xs);
    padding-block: var(--spacing-fluid-s);
    cursor: pointer;
    user-select: none;

    &:hover .work-title {
      color: var(--color-text);
    }
  }

  .work-header {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
  }

  .work-title {
    font-size: var(--text-fluid-sm);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 180ms ease-out;
  }

  details[open] .work-title {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    color: var(--color-text);
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }

  .work-sep {
    color: var(--color-text-faint);
    font-size: var(--text-fluid-xs);
  }

  .work-year {
    font-size: var(--text-fluid-xs);
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .work-type {
    font-size: var(--text-fluid-xs);
    color: var(--color-text-faint);
    text-transform: lowercase;
  }

  .disclosure-icon {
    flex-shrink: 0;
    color: var(--color-text-faint);
    rotate: -90deg;
    transition:
      rotate 180ms ease-out,
      color 180ms ease-out;
  }

  details[open] .disclosure-icon {
    rotate: 90deg;
    color: var(--color-text-muted);
  }

  /* ── Accordion animation ── */
  .work-body-outer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  details[open] + .work-body-outer {
    grid-template-rows: 1fr;
  }

  .work-body {
    overflow: hidden;
  }

  .work-body-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-fluid-s);
    padding-bottom: var(--spacing-fluid-s);
  }

  .work-description {
    font-size: var(--text-fluid-xs);
    color: var(--color-text-muted);
    line-height: var(--line-height-body);
  }

  .work-link {
    font-size: var(--text-fluid-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;

    &:hover {
      color: var(--color-text);
    }
  }

  .work-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-fluid-s);
  }

  .work-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  @media (min-width: 640px) {
    .work-body-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--spacing-fluid-m);
    }

    .work-text {
      flex: 1;
    }

    .work-image {
      width: auto;
      max-height: 10rem;
      object-fit: cover;
      flex-shrink: 0;
    }
  }
</style>
