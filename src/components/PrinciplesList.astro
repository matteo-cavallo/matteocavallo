---
import type { Principle } from "../data/site"

interface Props {
  items: Principle[]
}

const { items } = Astro.props
---

<ol class="principles-list">
  {
    items.map(({ title, description }) => (
      <li class="principle-item">
        <strong class="principle-title">{title}</strong>
        <p class="principle-desc" set:html={description} />
      </li>
    ))
  }
</ol>

<style>
  .principles-list {
    list-style: none;
    padding: 0;
    counter-reset: list-item;
  }

  .principle-item {
    padding-block: var(--spacing-fluid-l);
    border-bottom: 1px solid var(--color-border-subtle);
    counter-increment: list-item;

    &:first-child {
      padding-top: 0;
    }

    &:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    &::before {
      content: "0" counter(list-item);
      display: block;
      font-size: var(--text-fluid-xs);
      color: var(--color-text-faint);
      font-variant-numeric: tabular-nums;
      margin-bottom: var(--spacing-fluid-2xs);
    }
  }

  .principle-title {
    display: block;
    font-size: var(--text-fluid-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--color-text);
  }

  .principle-desc {
    color: var(--color-text-muted);
    margin-top: var(--spacing-fluid-s);
    max-width: var(--measure-narrow);
  }
</style>
