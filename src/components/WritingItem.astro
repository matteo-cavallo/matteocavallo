---
interface Props {
  title: string
  href: string
  date: Date
  description: string
}

const { title, href, date, description } = Astro.props

const dateFormatted = date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<a href={href} class="item">
  <h3><span class="link-underline">{title}</span></h3>
  <p class="meta">
    <time datetime={date.toISOString()}>{dateFormatted}</time>
  </p>
  {description && <p class="description">{description}</p>}
</a>

<style>
  .item {
    display: block;
    padding-block: var(--spacing-fluid-l);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .item:first-child {
    padding-top: 0;
  }

  .item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  h3 {
    font-size: var(--text-fluid-lg);
    line-height: var(--line-height-tight);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .item:hover .link-underline,
  .item:focus-visible .link-underline {
    background-size: 100% 1px;
  }

  .meta {
    color: var(--color-text-muted);
    margin-top: var(--spacing-fluid-2xs);
    font-size: var(--text-fluid-xs);
  }

  .description {
    color: var(--color-text);
    margin-top: var(--spacing-fluid-s);
    max-width: var(--measure-narrow);
  }
</style>
