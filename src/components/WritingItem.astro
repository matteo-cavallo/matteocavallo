---
interface Props {
  title: string
  href: string
  date: Date
  description: string
}

const { title, href, date, description } = Astro.props

const dateFormatted = date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<div class="border-border border-b py-6 first:pt-0 last:border-0 last:pb-0">
  <p class="text-text-faint mb-2 font-sans text-xs tracking-widest uppercase">
    {dateFormatted}
  </p>
  <a href={href} class="group inline-block">
    <p
      class="text-text group-hover:text-text-muted font-sans text-base font-medium transition-colors duration-150"
    >
      {title}
    </p>
  </a>
  <p class="text-text-muted mt-3 text-sm leading-relaxed">
    {description}
  </p>
</div>
