---
interface Props {
  title: string
  href: string
  date: Date
  description: string
}

const { title, href, date, description } = Astro.props

const year = date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  year: "numeric",
})
---

<a
  href={href}
  class="group block py-(--spacing-fluid-l) border-b border-border-subtle first:pt-0 last:border-0 last:pb-0 no-underline hover:no-underline"
>
  <h3
    class="text-(length:--text-fluid-lg) leading-(--line-height-tight) tracking-(--tracking-tight) font-semibold text-text"
  >
    <span class="writing-link">{title}</span>
  </h3>
  <p class="text-text-muted mt-1 text-sm">
    writing <time datetime={date.toISOString()}>{year}</time>
  </p>
  {
    description && (
      <p class="text-text mt-(--spacing-fluid-s) max-w-[55ch]">{description}</p>
    )
  }
</a>

<style>
  .writing-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 350ms cubic-bezier(0.65, 0, 0.35, 1);
    padding-bottom: 0.1em;
  }
  .group:hover .writing-link,
  .group:focus-visible .writing-link {
    background-size: 100% 1px;
  }
</style>
