---
interface Props {
  title: string
  href: string
  date: Date
}

import { formatDate } from "../utils/date"

const { title, href, date } = Astro.props
const dateFormatted = formatDate(date)
---

<a href={href} class="item">
  <h3 class="title">{title}</h3>
  <p class="meta">
    <time datetime={date.toISOString()}>{dateFormatted}</time>
  </p>
</a>

<style>
  .item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: var(--spacing-fluid-m);
    padding-block: var(--spacing-fluid-s);

    &:first-child {
      padding-top: 0;
    }
  }

  .title {
    grid-column: 1;
    font-size: var(--text-fluid-sm);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-tight);
    color: var(--color-text-muted);
    transition: color 200ms ease;
  }

  .item:is(:hover, :focus-visible) .title {
    color: var(--color-text);
  }

  .meta {
    grid-column: 2;
    grid-row: 1;
    color: var(--color-text-faint);
    font-size: var(--text-fluid-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
