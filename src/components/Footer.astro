---
import { Icon } from "astro-icon/components"
import { site } from "../data/site"

const socials = [
  {
    href: `mailto:${site.author.email}`,
    label: "Email",
    icon: "lucide:mail",
  },
  {
    href: site.social.github,
    label: "GitHub",
    icon: "simple-icons:github",
    external: true,
  },
  {
    href: site.social.linkedin,
    label: "LinkedIn",
    icon: "simple-icons:linkedin",
    external: true,
  },
  {
    href: site.social.instagram,
    label: "Instagram",
    icon: "simple-icons:instagram",
    external: true,
  },
]
---

<footer class="border-t border-border-subtle">
  <div
    class="mx-auto flex max-w-2xl flex-col gap-(--spacing-fluid-l) px-(--spacing-fluid-l) py-(--spacing-fluid-2xl)"
  >
    <ul class="flex flex-row flex-wrap gap-(--spacing-fluid-l) text-sm">
      {
        socials.map(({ href, label, icon, external }) => (
          <li>
            <a
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              class="inline-flex items-center gap-2 no-underline hover:underline"
            >
              <Icon name={icon} class="h-3.5 w-3.5" aria-hidden="true" />
              <span>{label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="banner text-text-muted text-sm inline-flex items-center gap-2">
      <span class="emoji" aria-hidden="true">🇫🇷</span>
      <span>{site.tagline}</span>
    </p>
  </div>
</footer>

<style>
  .banner .emoji {
    display: inline-block;
    transform: scale(1.3) translateY(0.01em);
    transform-origin: center;
  }
</style>
