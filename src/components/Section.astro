---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props
---

<section class="mb-(--spacing-fluid-3xl) flex flex-col">
  <h2
    class="text-(length:--text-fluid-xl) leading-(--line-height-tight) tracking-(--tracking-tight) font-semibold mb-(--spacing-fluid-l)"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-text-muted mb-(--spacing-fluid-l) max-w-[55ch]">
        {subtitle}
      </p>
    )
  }
  <div>
    <slot />
  </div>
</section>
