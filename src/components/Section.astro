---
interface Props {
  title: string
  subtitle: string
}

const { title, subtitle } = Astro.props
---

<section class="mb-12 flex flex-col gap-6">
  <div class="flex flex-col">
    <h2 class="mb-2 text-2xl font-bold tracking-tight">
      {title}
    </h2>
    <p class="font-light text-neutral-500">
      {subtitle}
    </p>
  </div>
  <div>
    <slot />
  </div>
</section>
