---
import Section from "./Section.astro"
import WritingItem from "./WritingItem.astro"
import { getFeaturedWritings } from "../utils/writings"

const featured = await getFeaturedWritings()
---

<Section title="Writings" subtitle="Notes from the making.">
  <div class="stack">
    {
      featured.map((piece) => (
        <WritingItem
          title={piece.data.title}
          href={`/writings/${piece.id}`}
          date={piece.data.date}
        />
      ))
    }
  </div>
  <p class="section-more">
    <a href="/writings" class="muted-link">All writings →</a>
  </p>
</Section>

<style>
  .section-more {
    margin-top: var(--spacing-fluid-l);
    font-size: var(--text-fluid-xs);
  }
</style>
