---
import { Icon } from "astro-icon/components"

interface Props {
  title: string
  kicker?: string
  datePublished?: string | Date
  dateModified?: string | Date
  image?: string
  imageAlt?: string
}

const { title, kicker, datePublished, dateModified, image, imageAlt } = Astro.props

function fmtDate(val: string | Date, forceYear = false): string {
  const d = new Date(val)
  const showYear = forceYear || d.getUTCFullYear() !== new Date().getUTCFullYear()
  return new Intl.DateTimeFormat("en-US", {
    timeZone: "UTC",
    month: "short",
    day: "numeric",
    ...(showYear ? { year: "numeric" } : {}),
  }).format(d)
}

const plantedStr = datePublished ? fmtDate(datePublished, true) : null
const tendedStr =
  dateModified && String(dateModified) !== String(datePublished)
    ? fmtDate(dateModified)
    : null
---

<header class="page-header">
  {kicker && <p class="page-kicker">{kicker}</p>}
  {image && (
    <div class="page-image">
      <img src={image} alt={imageAlt ?? ""} />
    </div>
  )}
  <hgroup role="group" aria-roledescription="Heading group">
    <h1 class="page-title">{title}</h1>
    <slot />
  </hgroup>
  {
    plantedStr && (
      <p class="page-dates">
        <Icon name="lucide:sprout" class="sprout-icon" aria-hidden="true" />Planted {plantedStr}
        {tendedStr && <span class="tended"> + tended {tendedStr}</span>}
      </p>
    )
  }
</header>

<style>
  .sprout-icon {
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    vertical-align: -0.1em;
    margin-inline-end: 0.35em;
    color: var(--color-text-faint);
  }
</style>
