---
interface Props {
  title: string
  subtitle?: string
  kicker?: string
}

const { title, subtitle, kicker } = Astro.props
---

<header class="page-header">
  {kicker && <p class="page-kicker">{kicker}</p>}
  <h1 class="page-title">{title}</h1>
  {
    subtitle && (
      <p class="page-subtitle">
        <em>{subtitle}</em>
      </p>
    )
  }
</header>

<style>
  .page-header {
    margin-bottom: var(--spacing-fluid-2xl);
  }

  .page-kicker {
    color: var(--color-text-muted);
    font-size: var(--text-fluid-xs);
    text-transform: lowercase;
    letter-spacing: var(--tracking-loose, 0.02em);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--spacing-fluid-m);
  }

  .page-title {
    font-size: var(--text-fluid-3xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    margin-top: var(--spacing-fluid-s);
    max-width: 55ch;
  }
</style>
