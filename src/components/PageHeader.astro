---
import { Icon } from "astro-icon/components"
import { formatDate } from "../utils/date"

interface Props {
  title: string
  kicker?: string
  datePublished?: string | Date
  dateModified?: string | Date
  image?: string
  imageAlt?: string
}

const { title, kicker, datePublished, dateModified, image, imageAlt } =
  Astro.props

const plantedStr = datePublished
  ? formatDate(datePublished, { month: "short", forceYear: true })
  : null
const tendedStr =
  dateModified && String(dateModified) !== String(datePublished)
    ? formatDate(dateModified, { month: "short", forceYear: false })
    : null
---

<header class="page-header">
  {kicker && <p class="page-kicker">{kicker}</p>}
  {
    image && (
      <div class="page-image">
        <img src={image} alt={imageAlt ?? ""} />
      </div>
    )
  }
  <hgroup role="group" aria-roledescription="Heading group">
    <h1 class="page-title">{title}</h1>
    <slot />
  </hgroup>
  {
    plantedStr && (
      <p class="page-dates">
        <Icon name="lucide:sprout" class="sprout-icon" aria-hidden="true" />
        Planted {plantedStr}
        {tendedStr && <span class="tended"> + tended {tendedStr}</span>}
      </p>
    )
  }
</header>

<style>
  .sprout-icon {
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    vertical-align: -0.1em;
    margin-inline-end: 0.35em;
    color: var(--color-text-faint);
  }
</style>
