---
import Signature from "./Signature.astro"

const currentPath = Astro.url.pathname
const topLevel = "/" + (currentPath.split("/")[1] ?? "")

const nav = [
  { label: "About", href: "/about" },
  { label: "Writings", href: "/writings" },
]
---

<header class="site-header">
  <div
    class="mx-auto flex w-full max-w-2xl items-center justify-between gap-(--spacing-fluid-m) px-(--spacing-fluid-l) py-(--spacing-fluid-l)"
  >
    <a href="/" class="signature-link" aria-label="Home, Matteo Cavallo">
      <Signature class="h-5 w-auto md:h-6" />
    </a>
    <nav aria-label="Primary" class="site-nav">
      {
        nav.map(({ label, href }) => {
          const isActive = topLevel === href
          return (
            <a
              href={href}
              class:list={["nav-link", { active: isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          )
        })
      }
    </nav>
  </div>
</header>

<style>
  .signature-link {
    display: inline-flex;
    text-decoration: none;
    color: var(--color-text);
    line-height: 1;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-fluid-2xs);
    margin-inline-end: calc(-1 * var(--spacing-fluid-s));
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text);
    line-height: 1;
    padding: var(--spacing-fluid-xs) var(--spacing-fluid-s);
    border-radius: 9999px;
    transition: font-weight 200ms ease;
  }

  .nav-link.active {
    font-weight: var(--font-weight-semibold);
  }

  @media (hover: hover) {
    .nav-link:hover {
      font-weight: var(--font-weight-semibold);
    }
  }
</style>
