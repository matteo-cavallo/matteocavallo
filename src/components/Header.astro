---
import Signature from "./Signature.astro"

const currentPath = Astro.url.pathname
const topLevel = "/" + (currentPath.split("/")[1] ?? "")

const nav = [
  { label: "About", href: "/about" },
  { label: "Writings", href: "/writings" },
]
---

<header>
  <div class="container header-inner">
    <a href="/" aria-label="Home, Matteo Cavallo" class="logo-link">
      <Signature />
    </a>
    <nav aria-label="Primary">
      {
        nav.map(({ label, href }) => {
          const isActive = topLevel === href
          return (
            <a
              href={href}
              class:list={[{ active: isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          )
        })
      }
    </nav>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-fluid-m);
    padding-block: var(--spacing-fluid-l);
  }

  .logo-link {
    display: inline-flex;
    line-height: 1;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-fluid-2xs);
    margin-inline-end: calc(-1 * var(--spacing-fluid-s));
  }

  nav a {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    line-height: 1;
    padding: var(--spacing-fluid-xs) var(--spacing-fluid-s);
    border-radius: 9999px;
    transition: font-weight 200ms ease;
  }

  nav a.active {
    font-weight: var(--font-weight-semibold);
  }

  @media (hover: hover) {
    nav a:hover {
      font-weight: var(--font-weight-semibold);
    }
  }
</style>
